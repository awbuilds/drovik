# Drovik development configuration.
# For local development, copy this file to backend/.env (the backend's working
# directory) and fill in local values. Never commit a real .env file.
# This file contains placeholders only.

DROVIK_ENV=development
DROVIK_HTTP_ADDR=127.0.0.1:8080
DROVIK_PUBLIC_URL=http://localhost:8080
DROVIK_LOG_LEVEL=debug
DROVIK_LOG_FORMAT=text
DROVIK_SHUTDOWN_TIMEOUT=10s
DROVIK_READINESS_TIMEOUT=2s

# Data directory and SQLite database. Relative paths resolve from the working directory.
DROVIK_DATA_DIR=./data
DROVIK_DB_PATH=./data/drovik.db

# Authenticated encryption key for stored SSH credentials.
# Provide either a 32-byte base64 value or a path to a key file.
# Generate a development key with: openssl rand -base64 32
DROVIK_ENCRYPTION_KEY=
DROVIK_ENCRYPTION_KEY_FILE=./secrets/encryption.key

# Session policy.
DROVIK_SESSION_IDLE_TTL=12h
DROVIK_SESSION_ABSOLUTE_TTL=168h
DROVIK_COOKIE_SECURE=false

# Browser origin allowed to call the API and open WebSockets.
DROVIK_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080

# Built frontend directory served by the backend in production.
DROVIK_STATIC_DIR=../frontend/dist

# Login rate limiting.
DROVIK_LOGIN_RATE_LIMIT=10
DROVIK_LOGIN_RATE_WINDOW=1m

# SSH and operation defaults (used in later phases).
DROVIK_SSH_DIAL_TIMEOUT=10s
DROVIK_SSH_HANDSHAKE_TIMEOUT=15s
DROVIK_SSH_OPERATION_TIMEOUT=30s
DROVIK_SSH_MAX_SESSIONS_PER_USER=2
DROVIK_SSH_MAX_SESSIONS_GLOBAL=10

# Egress policy. Private/LAN targets are allowed by default for homelab use;
# loopback, link-local, multicast, unspecified and cloud metadata are blocked.
# Explicit operator allow/deny CIDRs override the defaults. Deny wins over allow.
DROVIK_EGRESS_ALLOW_PRIVATE=true
DROVIK_EGRESS_ALLOWED_CIDRS=
DROVIK_EGRESS_DENIED_CIDRS=

# SFTP limits. Uploads stream; editor content is bounded in memory.
DROVIK_SFTP_MAX_UPLOAD_BYTES=2147483648
DROVIK_SFTP_MAX_EDITOR_BYTES=1048576
DROVIK_SFTP_MAX_LIST_ENTRIES=5000
DROVIK_SFTP_MAX_RECURSIVE_ENTRIES=10000
DROVIK_SFTP_OPERATION_TIMEOUT=2m

# Host monitoring. Snapshots are cached per server; concurrent requests are
# coalesced. CPU and network rates appear on the second sample.
DROVIK_MONITOR_REFRESH_INTERVAL=5s
DROVIK_MONITOR_STALE_AFTER=1m
DROVIK_MONITOR_TIMEOUT=15s
DROVIK_MONITOR_MAX_OUTPUT_BYTES=262144
DROVIK_MONITOR_MAX_FILESYSTEMS=64
DROVIK_MONITOR_MAX_INTERFACES=64

# Process, systemd and journal operations. Actions run as the configured SSH
# user and never escalate privileges.
DROVIK_OPS_COMMAND_TIMEOUT=20s
DROVIK_PROCESS_MAX_ENTRIES=2000
DROVIK_SERVICE_MAX_UNITS=1000
DROVIK_LOG_MAX_LINES=1000
DROVIK_LOG_MAX_OUTPUT_BYTES=1048576

# Advanced management, snippets and optional metric retention.
DROVIK_ADVANCED_TIMEOUT=20s
DROVIK_ADVANCED_MAX_OUTPUT_BYTES=1048576
DROVIK_DOCKER_MAX_CONTAINERS=500
DROVIK_PACKAGE_MAX_ENTRIES=5000
DROVIK_SNIPPET_MAX_COMMAND_BYTES=8192
DROVIK_METRICS_RETENTION=24h
DROVIK_METRICS_MAX_SAMPLES=20000
