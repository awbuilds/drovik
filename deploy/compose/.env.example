# Copy to .env in this directory and fill in real values.
# Never commit the real file or the secret key.

DROVIK_PUBLIC_URL=https://drovik.example.com
DROVIK_TRUSTED_ORIGINS=https://drovik.example.com
DROVIK_ENCRYPTION_KEY_FILE=./secrets/encryption.key
DROVIK_LOG_LEVEL=info
DROVIK_IMAGE=ghcr.io/awbuilds/drovik:dev
